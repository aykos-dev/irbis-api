{
  "name": "irbis-api",
  "version": "0.0.1",
  "description": "Irbis API \u2014 NestJS + PostgreSQL + Prisma; owns openapi.json",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint . --quiet --no-inline-config",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:ci": "vitest run --silent --reporter=dot && vitest run --config ./vitest.config.e2e.ts --silent --reporter=dot",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs --output-type err",
    "slop": "! grep -rnE 'TODO|FIXME|@ts-ignore|eslint-disable|\\bmock' src --include='*.ts' --exclude='*.spec.ts' --exclude-dir=generated",
    "check": "npm run -s lint && npm run -s typecheck && npm run -s test:ci && npm run -s depcruise && npm run -s slop",
    "openapi:export": "tsc -p tsconfig.scripts.json && node dist-scripts/scripts/export-openapi.js",
    "admin:create": "tsc -p tsconfig.scripts.json && mkdir -p dist-scripts/src/features/auth/data && cp src/features/auth/data/*.txt dist-scripts/src/features/auth/data/ && node dist-scripts/scripts/admin-create.js"
  },
  "dependencies": {
    "@nestjs/common": "12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.1.3",
    "@nestjs/swagger": "12.0.2",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "nestjs-pino": "5.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.8",
    "@nestjs/schematics": "12.0.7",
    "@nestjs/testing": "12.1.3",
    "@testcontainers/postgresql": "12.2.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/supertest": "7.2.1",
    "@vitest/coverage-v8": "4.1.12",
    "dependency-cruiser": "18.6.0",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "source-map-support": "0.5.21",
    "supertest": "7.3.1",
    "testcontainers": "12.2.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  },
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  }
}
