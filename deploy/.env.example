# Copy to deploy/.env on the server and fill in real values there. Never commit deploy/.env.
# Only the fake SMS sender exists yet, and staging/prod refuse it, so the dev server runs APP_ENV=local.
NODE_ENV=development
APP_ENV=local
PORT=3000
LOG_LEVEL=info
CORS_ORIGINS=https://devadmin.wayout.uz
SMS_PROVIDER=fake
QA_TOOLS_ENABLED=false

# openssl rand -hex 32
JWT_ACCESS_SECRET=JWT_ACCESS_SECRET
# openssl rand -base64 32
PHONE_ENCRYPTION_KEY=PHONE_ENCRYPTION_KEY

POSTGRES_USER=irbis
POSTGRES_PASSWORD=DB_PASSWORD
POSTGRES_DB=irbis
DATABASE_URL=postgresql://irbis:DB_PASSWORD@db:5432/irbis

# SeaweedFS (S3) in the same compose project; nginx serves the lessons/ prefix at devapi.wayout.uz/media/.
S3_REGION=us-east-1
S3_BUCKET=irbis-media
S3_ACCESS_KEY_ID=S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=S3_SECRET_ACCESS_KEY
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=https://devapi.wayout.uz/media/irbis-media
