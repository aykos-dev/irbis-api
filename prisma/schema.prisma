// Models are added by features, each in its own migration (docs/architecture.md → Domain Model).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  user
  admin

  @@map("role")
}

enum Locale {
  uz
  ru
  en

  @@map("locale")
}

enum Experience {
  beginner
  weekend
  experienced

  @@map("experience")
}

enum Interest {
  peaks
  caves
  lakes
  camping
  trails

  @@map("interest")
}

enum BlockReasonCode {
  spam
  harassment
  unsafe
  fake_content
  other

  @@map("block_reason_code")
}

enum SmsPurpose {
  password_reset
  phone_verify

  @@map("sms_purpose")
}

enum AdminAction {
  block
  unblock
  set_password
  set_recovery_phone
  change_role

  @@map("admin_action")
}

enum HomeRegion {
  tashkent_city
  tashkent_region
  andijan
  bukhara
  fergana
  jizzakh
  karakalpakstan
  khorezm
  namangan
  navoiy
  kashkadarya
  samarkand
  syrdarya
  surkhandarya
  other

  @@map("home_region")
}

enum Units {
  metric
  imperial

  @@map("units")
}

enum Appearance {
  light
  dark
  auto

  @@map("appearance")
}

enum NotificationCategory {
  trips
  social
  rewards

  @@map("notification_category")
}

// Usernames are stored lowercase; the unique index and CHECKs in the auth_init migration enforce it.
model User {
  id                      String           @id @default(uuid(7)) @db.Uuid
  username                String           @unique @db.VarChar(20)
  // Null for a demo account (ADR-006): it cannot log in with a password until secured.
  passwordHash            String?          @map("password_hash")
  isDemo                  Boolean          @default(false) @map("is_demo")
  // AES-256-GCM ciphertext of the verified recovery phone; never logged or returned in full.
  recoveryPhone           String?          @map("recovery_phone")
  recoveryPhoneVerifiedAt DateTime?        @map("recovery_phone_verified_at") @db.Timestamptz(3)
  locale                  Locale
  role                    Role             @default(user)
  blockedAt               DateTime?        @map("blocked_at") @db.Timestamptz(3)
  blockReasonCode         BlockReasonCode? @map("block_reason_code")
  termsAcceptedAt         DateTime?        @map("terms_accepted_at") @db.Timestamptz(3)
  experience              Experience?
  interests               Interest[]       @default([])
  lastActiveAt            DateTime         @default(now()) @map("last_active_at") @db.Timestamptz(3)
  createdAt               DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  // levels: written only by LevelsService (XP via xp_entries, level via level_ups); never lowered.
  level                   Int              @default(1)
  xpTotal                 Int              @default(0) @map("xp_total")
  levelReachedAt          DateTime         @default(now()) @map("level_reached_at") @db.Timestamptz(3)

  // profile: edited through PATCH /v1/me; avatar bytes stay in object storage, the column holds the key.
  displayName      String?      @map("display_name") @db.VarChar(40)
  bio              String?      @db.VarChar(150)
  homeRegion       HomeRegion?  @map("home_region")
  avatarKey        String?      @map("avatar_key") @db.VarChar(255)
  showStats        Boolean      @default(true) @map("show_stats")
  showHomeRegion   Boolean      @default(false) @map("show_home_region")
  units            Units        @default(metric)
  appearance       Appearance   @default(auto)
  notifyStreak     Boolean      @default(true) @map("notify_streak")
  notifyDailyGame  Boolean      @default(true) @map("notify_daily_game")
  dailyGameTime    String       @default("19:00") @map("daily_game_time") @db.VarChar(5)
  notifyGroups     Boolean      @default(true) @map("notify_groups")
  notifySocial     Boolean      @default(true) @map("notify_social")
  notifyOffers     Boolean      @default(false) @map("notify_offers")
  publicProfile    Boolean      @default(true) @map("public_profile")
  findBuddies      Boolean      @default(true) @map("find_buddies")
  deletedAt        DateTime?    @map("deleted_at") @db.Timestamptz(3)

  refreshTokens     RefreshToken[]
  smsCodes          SmsCode[]
  auditAsAdmin      AdminAuditLog[]     @relation("AuditAdmin")
  auditAsTarget     AdminAuditLog[]     @relation("AuditTarget")
  closuresCreated   Closure[]           @relation("ClosureCreatedBy")
  closuresEnded     Closure[]           @relation("ClosureEndedBy")
  overridesCreated  ConditionOverride[] @relation("OverrideCreatedBy")
  overridesEnded    ConditionOverride[] @relation("OverrideEndedBy")
  xpEntries         XpEntry[]
  levelFacts        LevelFact[]
  levelUps          LevelUp[]
  lessonCompletions LessonCompletion[]
  notifications     Notification[]
  pathMonths        PathMonth[]
  checkIns          CheckIn[]
  activityDays      ActivityDay[]
  streakState       StreakState?
  streakFreezes     StreakFreeze[]
  emergencyContact  EmergencyContact?
  trips             Trip[]

  @@index([createdAt, id])
  @@index([lastActiveAt, id])
  @@index([role])
  @@index([blockedAt])
  @@map("users")
}

model RefreshToken {
  id           String    @id @default(uuid(7)) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  // Set when this token was exchanged for a new one; presenting a rotated token again is reuse.
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("Rotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("Rotation")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

// One SMS code: password reset or recovery-phone verification (phone_verify keeps the pending phone).
model SmsCode {
  id        String     @id @default(uuid(7)) @db.Uuid
  userId    String     @map("user_id") @db.Uuid
  purpose   SmsPurpose
  phone     String
  codeHash  String     @map("code_hash")
  expiresAt DateTime   @map("expires_at") @db.Timestamptz(3)
  attempts  Int        @default(0)
  usedAt    DateTime?  @map("used_at") @db.Timestamptz(3)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
  @@map("sms_codes")
}

// One row per demo account created (ADR-006), for the per-IP daily limit. HMAC of the IP, never the raw IP.
model DemoCreation {
  id        String   @id @default(uuid(7)) @db.Uuid
  ipHash    String   @map("ip_hash") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([ipHash, createdAt])
  @@map("demo_creations")
}

// Log-in attempts for lockout (per username) and throttling (per IP). username is lowercase, may not exist.
model LoginAttempt {
  id       String   @id @default(uuid(7)) @db.Uuid
  username String   @db.VarChar(64)
  ip       String   @db.VarChar(64)
  ok       Boolean
  at       DateTime @default(now()) @db.Timestamptz(3)

  @@index([username, at])
  @@index([ip, at])
  @@map("login_attempts")
}

// Append-only. Never holds a password or a full phone number.
model AdminAuditLog {
  id         String           @id @default(uuid(7)) @db.Uuid
  adminId    String           @map("admin_id") @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  action     AdminAction
  reasonCode BlockReasonCode? @map("reason_code")
  note       String           @db.VarChar(500)
  detail     String?          @db.VarChar(200)
  at         DateTime         @default(now()) @db.Timestamptz(3)

  admin User @relation("AuditAdmin", fields: [adminId], references: [id], onDelete: Restrict)
  user  User @relation("AuditTarget", fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, at, id])
  @@index([adminId])
  @@map("admin_audit_logs")
}

enum PlaceType {
  peak
  lake
  cave
  camping
  trail
  waterfall
  canyon

  @@map("place_type")
}

enum SeasonStatus {
  best
  possible
  closed

  @@map("season_status")
}

enum Hazard {
  avalanche
  flood
  mudslide
  heat
  road

  @@map("hazard")
}

// Curated destinations. Seeded from prisma/seed/places.data.ts (upsert by slug).
model Place {
  id            String         @id @default(uuid(7)) @db.Uuid
  slug          String         @unique @db.VarChar(120)
  nameUz        String         @map("name_uz") @db.VarChar(200)
  nameRu        String?        @map("name_ru") @db.VarChar(200)
  nameEn        String?        @map("name_en") @db.VarChar(200)
  type          PlaceType
  latitude      Float
  longitude     Float
  elevationM    Int            @map("elevation_m")
  difficulty    Int
  requiredLevel Int            @map("required_level")
  region        String?        @db.VarChar(200)
  descriptionUz String?        @map("description_uz")
  descriptionRu String?        @map("description_ru")
  descriptionEn String?        @map("description_en")
  // Either empty (not set yet) or 12 entries, January first.
  season        SeasonStatus[] @default([])
  hazards       Hazard[]       @default([])
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  condition PlaceCondition?
  forecast  PlaceForecast?
  closures  Closure[]
  overrides ConditionOverride[]
  pathNodes PathNode[]
  trips     Trip[]
  checkIns  CheckIn[]

  @@index([type])
  @@map("places")
}

enum ConditionStatus {
  go
  caution
  not_now
  seasonal_lock
}

enum ConditionSource {
  forecast
  hazard_rule
  closure
  season
  manual
}

enum ClosureSource {
  official
  admin
}

// Computed condition per place (rules + closures + overrides + season); rewritten by the hourly job.
model PlaceCondition {
  placeId      String           @id @map("place_id") @db.Uuid
  status       ConditionStatus?
  source       ConditionSource?
  reasons      Json
  hazardLevels Json             @map("hazard_levels")
  weekend      Json
  forecastAt   DateTime?        @map("forecast_at") @db.Timestamptz(3)
  computedAt   DateTime         @map("computed_at") @db.Timestamptz(3)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("place_conditions")
}

// Last successful Open-Meteo daily forecast (past 3 + next 7 days) per place.
model PlaceForecast {
  placeId   String   @id @map("place_id") @db.Uuid
  daily     Json
  fetchedAt DateTime @map("fetched_at") @db.Timestamptz(3)

  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@map("place_forecasts")
}

// Never deleted: ending sets endedAt/endedById (audit trail).
model Closure {
  id          String        @id @default(uuid(7)) @db.Uuid
  placeId     String        @map("place_id") @db.Uuid
  startsAt    DateTime      @map("starts_at") @db.Timestamptz(3)
  endsAt      DateTime?     @map("ends_at") @db.Timestamptz(3)
  reasonUz    String        @map("reason_uz") @db.VarChar(500)
  reasonRu    String?       @map("reason_ru") @db.VarChar(500)
  reasonEn    String?       @map("reason_en") @db.VarChar(500)
  source      ClosureSource
  createdById String        @map("created_by_id") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  endedAt     DateTime?     @map("ended_at") @db.Timestamptz(3)
  endedById   String?       @map("ended_by_id") @db.Uuid

  place     Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdBy User  @relation("ClosureCreatedBy", fields: [createdById], references: [id])
  endedBy   User? @relation("ClosureEndedBy", fields: [endedById], references: [id])

  @@index([placeId, endedAt])
  @@map("closures")
}

// Never deleted: ending sets endedAt/endedById (audit trail).
model ConditionOverride {
  id          String          @id @default(uuid(7)) @db.Uuid
  placeId     String          @map("place_id") @db.Uuid
  status      ConditionStatus
  reasonUz    String          @map("reason_uz") @db.VarChar(500)
  reasonRu    String?         @map("reason_ru") @db.VarChar(500)
  reasonEn    String?         @map("reason_en") @db.VarChar(500)
  expiresAt   DateTime        @map("expires_at") @db.Timestamptz(3)
  createdById String          @map("created_by_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  endedAt     DateTime?       @map("ended_at") @db.Timestamptz(3)
  endedById   String?         @map("ended_by_id") @db.Uuid

  place     Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
  createdBy User  @relation("OverrideCreatedBy", fields: [createdById], references: [id])
  endedBy   User? @relation("OverrideEndedBy", fields: [endedById], references: [id])

  @@index([placeId, endedAt])
  @@map("condition_overrides")
}

// --- levels ---

// Numbers the doc calls "decided after testing" (level table, XP caps); validated by zod at use.
model GameConfig {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("game_config")
}

enum XpSource {
  lesson
  check_in
  waypoint
  discoverer
  top_shots
  post
  game
  campfire
  qa_grant
  path_chest
}

// Append-only XP ledger; User.xpTotal is the running sum. One row per (user, source, refId).
model XpEntry {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  source    XpSource
  refId     String   @map("ref_id") @db.VarChar(200)
  amount    Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, source, refId])
  @@index([userId, source, createdAt])
  @@map("xp_entries")
}

enum LevelFactKind {
  lesson
  check_in
  verified_spot
}

// Facts the level gates count (lessons done, check-ins, verified spots). One row per (user, kind, refId).
model LevelFact {
  id         String        @id @default(uuid(7)) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  kind       LevelFactKind
  refId      String        @map("ref_id") @db.VarChar(200)
  tier       String?       @db.VarChar(50)
  difficulty Int?
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, refId])
  @@index([userId, kind])
  @@map("level_facts")
}

// One row per level step (a 2→4 jump writes 2→3 and 3→4). seenAt set when the app shows it.
model LevelUp {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  fromLevel Int       @map("from_level")
  toLevel   Int       @map("to_level")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  seenAt    DateTime? @map("seen_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, seenAt])
  @@map("level_ups")
}

// Lessons (admin content). Tier `key` never changes: level gates read it.
model LessonTier {
  id        String   @id @default(uuid(7)) @db.Uuid
  key       String   @unique @db.VarChar(20)
  title     Json
  colour    String   @db.VarChar(7)
  order     Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  lessons Lesson[]

  @@map("lesson_tiers")
}

enum LessonStatus {
  draft
  published

  @@map("lesson_status")
}

model Lesson {
  id          String       @id @default(uuid(7)) @db.Uuid
  tierId      String       @map("tier_id") @db.Uuid
  title       Json
  icon        String       @db.VarChar(20)
  order       Int
  status      LessonStatus @default(draft)
  publishedAt DateTime?    @map("published_at") @db.Timestamptz(3)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  tier        LessonTier         @relation(fields: [tierId], references: [id], onDelete: Restrict)
  questions   LessonQuestion[]
  completions LessonCompletion[]

  @@index([tierId, status, order])
  @@map("lessons")
}

model LessonQuestion {
  id               String  @id @default(uuid(7)) @db.Uuid
  lessonId         String  @map("lesson_id") @db.Uuid
  order            Int
  prompt           Json
  hint             Json?
  options          Json
  correctIndex     Int     @map("correct_index")
  explanation      Json
  wrongExplanation Json?   @map("wrong_explanation")
  imageKey         String? @map("image_key") @db.VarChar(200)

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([lessonId, order])
  @@map("lesson_questions")
}

// First completion of a lesson per user (features/lessons.md AC2). Repeats write nothing.
model LessonCompletion {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  lessonId    String   @map("lesson_id") @db.Uuid
  completedAt DateTime @map("completed_at") @db.Timestamptz(3)
  wrongCount  Int      @map("wrong_count")
  perfect     Boolean
  xp          Int
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId, completedAt])
  @@map("lesson_completions")
}

// In-app notification inbox (profile-4). Copy is pre-localised JSON; no producers exist yet.
model Notification {
  id        String               @id @default(uuid(7)) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  category  NotificationCategory
  kind      String               @db.VarChar(50)
  title     Json
  body      Json?
  data      Json?
  readAt    DateTime?            @map("read_at") @db.Timestamptz(3)
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt, id])
  @@index([userId, readAt])
  @@map("notifications")
}

// --- weekly-path ---

// A user's path for one Asia/Tashkent month (YYYY-MM). Picked once, then frozen.
model PathMonth {
  id            String    @id @default(uuid(7)) @db.Uuid
  userId        String    @map("user_id") @db.Uuid
  month         String    @db.VarChar(7)
  // The user's level when the path was picked.
  level         Int
  chestOpenedAt DateTime? @map("chest_opened_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodes PathNode[]

  @@unique([userId, month])
  @@map("path_months")
}

model PathNode {
  id          String    @id @default(uuid(7)) @db.Uuid
  pathMonthId String    @map("path_month_id") @db.Uuid
  position    Int
  placeId     String    @map("place_id") @db.Uuid
  visitedAt   DateTime? @map("visited_at") @db.Timestamptz(3)

  pathMonth PathMonth @relation(fields: [pathMonthId], references: [id], onDelete: Cascade)
  place     Place     @relation(fields: [placeId], references: [id], onDelete: Cascade)

  @@unique([pathMonthId, position])
  @@unique([pathMonthId, placeId])
  @@index([placeId])
  @@map("path_nodes")
}

// Last successful Open-Meteo daily forecast for a fixed point (key `tashkent`), not a place.
model PointForecast {
  key       String   @id @db.VarChar(50)
  daily     Json
  fetchedAt DateTime @map("fetched_at") @db.Timestamptz(3)

  @@map("point_forecasts")
}

// trip-plan: one emergency contact per user; phone is PhoneCipher ciphertext, never logged or returned in full.
model EmergencyContact {
  userId     String   @id @map("user_id") @db.Uuid
  name       String   @db.VarChar(60)
  relation   String   @db.VarChar(30)
  phone      String
  phoneLast2 String   @map("phone_last2") @db.Char(2)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

enum TripStatus {
  planned
  active
  checked_out
  alerted

  @@map("trip_status")
}

// trip-plan: the contact is a snapshot taken at create. One `active` trip per user (partial unique index in SQL).
model Trip {
  id                String     @id @default(uuid(7)) @db.Uuid
  userId            String     @map("user_id") @db.Uuid
  placeId           String     @map("place_id") @db.Uuid
  status            TripStatus
  startAt           DateTime   @map("start_at") @db.Timestamptz(3)
  backBy            DateTime   @map("back_by") @db.Timestamptz(3)
  alertEnabled      Boolean    @map("alert_enabled")
  contactName       String     @map("contact_name") @db.VarChar(60)
  contactRelation   String     @map("contact_relation") @db.VarChar(30)
  contactPhone      String     @map("contact_phone")
  contactPhoneLast2 String     @map("contact_phone_last2") @db.Char(2)
  startedAt         DateTime?  @map("started_at") @db.Timestamptz(3)
  startLat          Float?     @map("start_lat")
  startLng          Float?     @map("start_lng")
  startAccuracyM    Float?     @map("start_accuracy_m")
  checkedOutAt      DateTime?  @map("checked_out_at") @db.Timestamptz(3)
  alertSentAt       DateTime?  @map("alert_sent_at") @db.Timestamptz(3)
  alertAttempts     Int        @default(0) @map("alert_attempts")
  liveToken         String?    @unique @map("live_token") @db.Char(22)
  lastLat           Float?     @map("last_lat")
  lastLng           Float?     @map("last_lng")
  lastAccuracyM     Float?     @map("last_accuracy_m")
  lastLocationAt    DateTime?  @map("last_location_at") @db.Timestamptz(3)
  distanceM         Int        @default(0) @map("distance_m")
  climbM            Int        @default(0) @map("climb_m")
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  place     Place          @relation(fields: [placeId], references: [id], onDelete: Cascade)
  waypoints TripWaypoint[]
  sos       TripSos[]

  @@index([userId, startAt])
  @@index([status, backBy])
  @@map("trips")
}

/// A waypoint reached on an active trip (XP awarded per trip.active.waypoint rules).
model TripWaypoint {
  id         String   @id @default(uuid(7)) @db.Uuid
  tripId     String   @map("trip_id") @db.Uuid
  n          Int
  lat        Float
  lng        Float
  accuracyM  Float    @map("accuracy_m")
  recordedAt DateTime @map("recorded_at") @db.Timestamptz(3)
  xpAwarded  Int      @map("xp_awarded")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, n])
  @@map("trip_waypoints")
}

enum TripSosStatus {
  sent
  failed

  @@map("trip_sos_status")
}

/// An SOS sent from an active trip.
model TripSos {
  id     String        @id @default(uuid(7)) @db.Uuid
  tripId String        @map("trip_id") @db.Uuid
  lat    Float?
  lng    Float?
  sentAt DateTime      @map("sent_at") @db.Timestamptz(3)
  status TripSosStatus

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId, sentAt])
  @@map("trip_sos")
}

/// A verified place check-in (features/check-in.md). One counted row per (user, place, Tashkent
/// month): a partial unique index in the check_in migration enforces it.
model CheckIn {
  id          String   @id @default(uuid(7)) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  placeId     String   @map("place_id") @db.Uuid
  /// Client-generated id; a retry with the same id replays the stored result.
  clientId    String   @map("client_id") @db.Uuid
  lat         Float
  lng         Float
  accuracyM   Float    @map("accuracy_m")
  recordedAt  DateTime @map("recorded_at") @db.Timestamptz(3)
  /// Asia/Tashkent YYYY-MM of recordedAt.
  month       String   @db.Char(7)
  counted     Boolean
  xpAwarded   Int      @default(0) @map("xp_awarded")
  pathVisited Boolean  @default(false) @map("path_visited")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place Place @relation(fields: [placeId], references: [id])

  @@unique([userId, clientId])
  @@index([userId, placeId, month])
  @@map("check_ins")
}

// --- streaks -----------------------------------------------------------------

enum StreakKind {
  flame
  boot
}

/// One Asia/Tashkent day with at least one lesson completion or accepted check-in.
model ActivityDay {
  userId   String   @map("user_id") @db.Uuid
  day      DateTime @db.Date
  lessons  Int      @default(0)
  checkIns Int      @default(0) @map("check_ins")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, day])
  @@map("activity_days")
}

/// Persisted streak evaluation: runs as of the end of `evaluatedThrough` (a Tashkent day before today).
model StreakState {
  userId           String    @id @map("user_id") @db.Uuid
  flameCount       Int       @default(0) @map("flame_count")
  flameLastDay     DateTime? @map("flame_last_day") @db.Date
  bootCount        Int       @default(0) @map("boot_count")
  /// Monday of the last fully evaluated week.
  bootLastWeek     DateTime? @map("boot_last_week") @db.Date
  evaluatedThrough DateTime? @map("evaluated_through") @db.Date
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("streak_states")
}

/// A freeze that covered a missed day (flame) or week Monday (boot); one pool per Tashkent month.
model StreakFreeze {
  id         String     @id @default(uuid(7)) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  kind       StreakKind
  coversDate DateTime   @map("covers_date") @db.Date
  /// Asia/Tashkent YYYY-MM the freeze counts against.
  month      String     @db.Char(7)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, coversDate])
  @@index([userId, month])
  @@map("streak_freezes")
}
