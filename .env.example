# Copy to .env and fill in real values locally. Never commit .env.

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (no "*").
CORS_ORIGINS=http://localhost:3001
# Max JSON / urlencoded body size (express "bytes" format).
BODY_LIMIT=100kb
# Global rate limit: LIMIT requests per TTL window per client.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Deployment tier: local | test | staging | prod. staging/prod refuse the fake SMS sender.
APP_ENV=local

# Auth (HS256 access tokens; at least 32 characters)
JWT_ACCESS_SECRET=JWT_ACCESS_SECRET
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
# Argon2id cost (defaults are the OWASP minimum; raise on strong hardware).
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
# Leave empty locally: local/test derive a key from JWT_ACCESS_SECRET. Staging/prod need a
# 32-byte base64 value (openssl rand -base64 32) from the secrets manager.
PHONE_ENCRYPTION_KEY=
# fake = logs "SMS code for user <id>: <code>" (local/test only). A real adapter comes later.
SMS_PROVIDER=fake
# Per-IP requests per window on sign-up / log-in / refresh / reset, and on username lookups.
AUTH_THROTTLE_LIMIT=20
AUTH_THROTTLE_TTL_MS=60000
LOOKUP_THROTTLE_LIMIT=30

# Database (docker compose uses the POSTGRES_* values; DATABASE_URL must match them)
POSTGRES_USER=irbis
POSTGRES_PASSWORD=DB_PASSWORD
POSTGRES_DB=irbis
DATABASE_URL=postgresql://irbis:DB_PASSWORD@localhost:5432/irbis

# Conditions: Open-Meteo forecast job (ADR-004) and rule thresholds
OPEN_METEO_BASE_URL=https://api.open-meteo.com
# Paid customer endpoint only; leave empty on the free tier.
OPEN_METEO_API_KEY=
CONDITIONS_FETCH_TIMEOUT_MS=10000
CONDITIONS_BATCH_SIZE=50
CONDITIONS_JOB_ENABLED=true
COND_GUST_NOT_NOW_KMH=60
COND_PRECIP_NOT_NOW_MM=20
COND_WIND_CAUTION_KMH=35
COND_PRECIP_PROB_CAUTION_PCT=60
COND_HEAT_CAUTION_C=35
COND_HEAT_NOT_NOW_C=40
COND_COLD_CAUTION_C=-10
COND_RAIN_HAZARD_CAUTION_MM=10
COND_RAIN_HAZARD_NOT_NOW_MM=30
COND_SNOW_CAUTION_CM=10
COND_SNOW_NOT_NOW_CM=30
COND_STALE_HOURS=6

# Object storage (ADR-005). Local: docker compose runs MinIO with these as its root user and creates
# the bucket. Staging/prod: any S3-compatible endpoint; bucket, keys and public URL are required there.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=irbis-media
S3_ACCESS_KEY_ID=S3_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=S3_SECRET_ACCESS_KEY
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/irbis-media

# Active trip: public web origin for live links, and the SOS call number.
WEB_PUBLIC_URL=http://localhost:3001
SOS_CALL_NUMBER=+998XXXXXXXXX
