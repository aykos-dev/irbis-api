# Copy to .env and fill in real values locally. Never commit .env.

# App
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (no "*").
CORS_ORIGINS=http://localhost:3001
# Max JSON / urlencoded body size (express "bytes" format).
BODY_LIMIT=100kb
# Global rate limit: LIMIT requests per TTL window per client.
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100

# Deployment tier: local | test | staging | prod. staging/prod refuse the fake SMS sender.
APP_ENV=local

# Auth (HS256 access tokens; at least 32 characters)
JWT_ACCESS_SECRET=JWT_ACCESS_SECRET
JWT_ACCESS_TTL_SEC=900
REFRESH_TTL_DAYS=30
# Argon2id cost (defaults are the OWASP minimum; raise on strong hardware).
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
# Leave empty locally: local/test derive a key from JWT_ACCESS_SECRET. Staging/prod need a
# 32-byte base64 value (openssl rand -base64 32) from the secrets manager.
PHONE_ENCRYPTION_KEY=
# fake = logs "SMS code for user <id>: <code>" (local/test only). A real adapter comes later.
SMS_PROVIDER=fake
# Per-IP requests per window on sign-up / log-in / refresh / reset, and on username lookups.
AUTH_THROTTLE_LIMIT=20
AUTH_THROTTLE_TTL_MS=60000
LOOKUP_THROTTLE_LIMIT=30

# Database (docker compose uses the POSTGRES_* values; DATABASE_URL must match them)
POSTGRES_USER=irbis
POSTGRES_PASSWORD=DB_PASSWORD
POSTGRES_DB=irbis
DATABASE_URL=postgresql://irbis:DB_PASSWORD@localhost:5432/irbis
